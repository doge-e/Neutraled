# Neutraled —— 只收工具链源码，不收游戏产物/第三方内容/构建产物

# 游戏与部署产物
*_windows/
*_linux/
*_macos/
*_unix/
data.win
*.win
*.ios

# 第三方 mod 内容（≈2.5GB，版权归各作者）
mods/

# 构建产物 / 依赖 / 二进制
builder/bin/
builder/obj/
**/bin/
**/obj/
*.exe
*.dll
*.pdb
*.zip

# 备份 / 缓存 / 存档 / 日志
backup/
.backup_files/
cache/
save-backups/
saves/
mod-saves/
snapshots/
restore/
logs/
.tmp/
_test/
*.log
*.tmp

# 编辑器 / 系统
.vs/
.idea/
.vscode/
Thumbs.db
desktop.ini

# 生成物（本轮整理新增：地图预览、API 注册表、构建输出、运行时残留）
kristal-maps/
api-registry.json
dist/
config.json.bak-*
console-history.txt
gui_lang.txt

# 本机运行时状态（不进仓库：含本机游戏路径、已装 mod 清单、语言/base_mod 等）
installed.json
config.json
mods.json
mods-shared.json
chapters.json
ns-registry.json
permissions.json
hook-registry.json
launch-request.json
scope.json
conflicts.json
blacklist.json
# 部署基线（Steam buildid / 各槽位指纹，纯本机状态；进仓库会让别人误判"已是最新"）
deploy-state.json
