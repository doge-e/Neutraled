<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ApplicationIcon>..\tools\icon.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ntl-gui</AssemblyName>
    <Version>1.0.7</Version>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <FileVersion>1.0.7.0</FileVersion>
    <RootNamespace>Neutraled.Gui</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- GUI-M03 / 裁决 u：config.json 的唯一写入口是 builder 的 ConfigFile（读-改-写 + 无 BOM + 镜像存档区）。
       GUI 直接引用 builder 工程，避免再复制一份「写游戏根 + 镜像」的规则导致两份文件漂移。 -->
  <ItemGroup>
    <ProjectReference Include="..\builder\Neutraled.Builder.csproj" />
  </ItemGroup>

</Project>
