<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ntl-mapedit</AssemblyName>
    <RootNamespace>NtlMapEdit</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <UtmtDir Condition="'$(NTL_UTMT_DIR)' != ''">$(NTL_UTMT_DIR)</UtmtDir>
    <UtmtDir Condition="'$(UtmtDir)' == ''">E:\steam\steamapps\common\DELTARUNE\UTMT</UtmtDir>
    <!-- WFO1000: our runtime properties are not designer-serialized (this form is code-built). -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UndertaleModLib"><HintPath>$(UtmtDir)\UndertaleModLib.dll</HintPath></Reference>
    <Reference Include="Underanalyzer"><HintPath>$(UtmtDir)\Underanalyzer.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(UtmtDir)\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Magick.NET-Q8-AnyCPU"><HintPath>$(UtmtDir)\Magick.NET-Q8-AnyCPU.dll</HintPath></Reference>
    <Reference Include="Magick.NET.Core"><HintPath>$(UtmtDir)\Magick.NET.Core.dll</HintPath></Reference>
    <None Include="$(UtmtDir)\Magick.Native-Q8-x64.dll" CopyToOutputDirectory="PreserveNewest" Link="Magick.Native-Q8-x64.dll" />
  </ItemGroup>
</Project>
