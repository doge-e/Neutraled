    ds_map_add(_zh, "err.budget", "循环次数超出限制（可能有死循环）");
    ds_map_add(_en, "err.budget", "loop iteration limit exceeded (possible infinite loop)");
    ds_map_add(_zh, "adv.stack", "检查递归是否有终止条件；或改用循环");
    ds_map_add(_en, "adv.stack", "check the recursion has a base case, or use a loop instead");
    ds_map_add(_zh, "err.stack", "递归太深（调用层数过多）");
    ds_map_add(_en, "err.stack", "recursion too deep (stack overflow)");
