/// {{NAME}} —— Neutraled 自定义章节入口脚本（最小骨架）
/// 脚本名 = 文件名；gml/main.gml 是本 mod 的入口，**游戏启动时执行一次**。
/// 这个模板只做一件事：证明 mod 被加载了（证据在日志里）。想画东西 / 要一个能走动的房间，用 --template room。

global.ntl_{{PREFIX}}_name = "{{NAME}}";

ntl_log("chapter", "[{{NAME}}] 入口脚本已执行（mod id={{MOD_ID}}，作者 {{AUTHOR}}）");
ntl_log("chapter", "[{{NAME}}] 模式={{MODE_LABEL}} order={{SLOT}} 基底={{BASE_CHAPTER}} mod 目录={{DIR_NAME}}");

